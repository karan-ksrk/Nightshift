[Unit]
Description=Nightshift Phase 2 upload API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ksrk
WorkingDirectory=/home/ksrk/nightshift
ExecStart=/home/ksrk/nightshift/venv/bin/python -m uvicorn server:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
